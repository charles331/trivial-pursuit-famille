GEMINI_API_KEY=

# Facultatif mais recommandé pour fiabiliser la caméra/micro entre des réseaux
# différents (Wi-Fi d'entreprise, 4G/5G, NAT strict).
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Persistance des parties (aucune base de données requise).
# Sur Railway : créez un Volume, montez-le sur /data, puis DATA_DIR=/data.
# Sans volume, les parties survivent aux redémarrages du processus mais pas
# au remplacement du conteneur.
DATA_DIR=

# Fenetre de conservation d un salon mis en pause (4 h par defaut).
ROOM_PAUSED_TTL_MS=
