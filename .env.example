GEMINI_API_KEY=

# Facultatif. Le jeu fonctionne sans : les serveurs STUN publics suffisent dans
# la grande majorite des cas, y compris entre deux box internet differentes. Un
# relais TURN ne devient necessaire que pour les reseaux qui refusent la
# connexion directe (NAT symetrique, 4G/5G de certains operateurs, Wi-Fi
# d'entreprise). Sans TURN, l'echec est signale aux joueurs concernes et la
# partie continue normalement.
#
# Pour en obtenir un : Cloudflare propose un service TURN gere (Cloudflare
# Realtime) qui fournit une URL et des identifiants a coller ci-dessous ;
# verifiez ses quotas et tarifs actuels avant de vous en servir. D'autres
# hebergeurs TURN geres existent, et coturn s'auto-heberge sur un petit VPS.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Persistance des parties (aucune base de données requise).
# Sur Railway : créez un Volume, montez-le sur /data, puis DATA_DIR=/data.
# Sans volume, les parties survivent aux redémarrages du processus mais pas
# au remplacement du conteneur.
DATA_DIR=

# Fenetre de conservation d un salon mis en pause (4 h par defaut).
ROOM_PAUSED_TTL_MS=
